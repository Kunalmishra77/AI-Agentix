# Copy to `.env` and fill in. NEVER commit the real .env.
# Server-side only — this key is never exposed to the browser.
OPENAI_API_KEY=

# Optional overrides
PORT=5000
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# Comma-separated allowed origins for CORS (production domain + localhost)
ALLOWED_ORIGINS=http://localhost:5173,https://ai-agentix.com
