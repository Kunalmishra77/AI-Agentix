# Copy to `.env` and fill in. NEVER commit the real .env.
# Everything here is server-side only — none of it is ever sent to the browser.

# --- AI assistant ---
# Leave EMPTY to run the assistant in free rule-based mode (answers from site content, no API cost).
# If set, also set a monthly hard spend limit in the OpenAI dashboard.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# Max paid AI replies per day across all visitors; after that the free mode answers.
LLM_DAILY_LIMIT=300

# --- server ---
PORT=5000
# Leave empty to listen on all interfaces (previous behaviour); 127.0.0.1 when nginx runs on the same machine.
HOST=
NODE_ENV=production
# Comma-separated site origins allowed to call /api (production domain + local dev)
ALLOWED_ORIGINS=https://ai-agentix.com,http://localhost:5173
# Number of reverse proxies in front of Express (nginx = 1; Caddy -> nginx = 2)
TRUST_PROXY_HOPS=1

# --- leads ---
# Folder where every lead is stored (leads.jsonl). Must be outside the web root and persist across deploys.
LEADS_DIR=/var/lib/ai-agentix/leads

# Email notification (Gmail: smtp.gmail.com / 465 / true, with a 16-character App Password —
# NOT the normal Gmail password; needs 2-Step Verification on that Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@example.com
SMTP_PASS=
LEAD_FROM=your-sending-account@example.com
# Comma-separated inboxes that receive each lead
LEAD_NOTIFY_TO=myai@ai-agentix.com

# Google Sheet (Apps Script web app — see server/docs/google-sheet-apps-script.gs)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_TOKEN=
